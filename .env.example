# Foley Strategic Advisory — first-party mailer
# Copy to .env locally. Never commit real keys.
# Soft HOLD: live sends to real recipients stay off until John unlocks.

# mock | resend | postmark
# Default mock: no network send. Resend is the preferred live pipe (see docs/MAILER.md).
MAILER_PROVIDER=mock

# Required before any non-mock send. Leave empty until DNS + domain verify are done.
MAIL_FROM=
MAIL_FROM_NAME=Foley Strategic Advisory
MAIL_REPLY_TO=john@foleysa.com

# Public origin used in DOI / unsubscribe links (no trailing slash).
MAILER_PUBLIC_BASE=http://127.0.0.1:8787

# HMAC secret for confirm/unsub tokens. Generate a long random string before production.
MAILER_SECRET=dev-only-change-me

# file (default, owns the list on disk) | memory (ephemeral; Vercel without a durable store)
SUBSCRIBER_STORE=file
# SUBSCRIBER_STORE_PATH=mailer/data/subscribers.json

# Local preview only. Never enable on the public host.
MAILER_DEV_REVEAL_CONFIRM=true

# Preferred ESP. Do not set until John creates the account.
# RESEND_API_KEY=

# Alternative ESP. Adapter is ready; default remains Resend.
# POSTMARK_SERVER_TOKEN=
# POSTMARK_MESSAGE_STREAM=broadcast

# Soft HOLD locks. Both must be set AND CLI --live --i-understand-soft-hold
# to send anything through a live provider. Leave unset.
# ALLOW_LIVE_SEND=false
